# Copy into Railway → your service → Variables. Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Your Netlify site (exact, no trailing slash)
SITE_URL=https://remarkable-capybara-9e90f5.netlify.app
# Leave empty: Netlify forwards /api to Railway, so it is all one domain
COOKIE_DOMAIN=

# Admin login (created/updated automatically on startup)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-long-strong-password

TWITTERAPI_KEY=your-twitterapi-io-key
OPENROUTER_API_KEY=your-openrouter-key
# AI models, tried in order (check exact IDs on openrouter.ai/models)
LLM_MODELS=qwen/qwen3.8-27b:free,z-ai/glm-5.2:free,deepseek/deepseek-v4-flash
